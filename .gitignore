# ==================================================
# 数据文件
# ==================================================
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep

# ==================================================
# Python
# ==================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.DS_Store
.venv/
venv/
.env
.serena/
models/*
!models/.gitkeep
usb_bundle/

