# Android - 构建产物
# ==================================================
android-app/app/build/
android-app/build/
android-app/.gradle/
android-app/.idea/
android-app/local.properties
android-app/captures/
android-app/*.apk
android-app/*.aab
android-app/*.ap_
android-app/output/
android-app/.externalNativeBuild
android-app/.cxx

# Gradle
android-app/gradle-app.setting
android-app/.navigation/
android-app/*/build/

# Keystore files
android-app/*.jks
android-app/*.keystore

# Debug
android-app/**/kotlin/
android-app/**/tmp/
android-app/**/.kotlin/

